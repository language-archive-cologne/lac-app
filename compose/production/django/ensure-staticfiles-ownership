#!/usr/bin/env bash
set -euo pipefail

die() {
  printf '[staticfiles-ownership] ERROR: %s\n' "$*" >&2
  exit 1
}

[[ "$#" -eq 3 ]] || {
  die "Usage: ensure-staticfiles-ownership STATIC_ROOT UID GID"
}

static_root=$1
target_uid=$2
target_gid=$3

[[ "${static_root}" == /* && "${static_root}" != "/" ]] || {
  die "Static root must be an absolute non-root path"
}
[[ "${target_uid}" =~ ^[0-9]+$ ]] || die "UID must be numeric"
[[ "${target_gid}" =~ ^[0-9]+$ ]] || die "GID must be numeric"
[[ ! -L "${static_root}" ]] || die "Static root must not be a symlink"
[[ ! -e "${static_root}" || -d "${static_root}" ]] || {
  die "Static root must be a directory"
}

install -d -m 0755 "${static_root}"
while IFS= read -r -d '' path; do
  chown --no-dereference "${target_uid}:${target_gid}" "${path}"
done < <(
  find "${static_root}" -xdev \
    \( ! -uid "${target_uid}" -o ! -gid "${target_gid}" \) \
    -print0
)
