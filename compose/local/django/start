#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# Run migrations
python manage.py migrate

# Start the development server on the same WSGI application production uses
# (ASGI leaked DB connections when clients aborted requests). Gunicorn logs
# no access log by default, which keeps HTMX polling output quiet.
exec /usr/local/bin/gunicorn config.wsgi \
    --bind 0.0.0.0:8000 \
    --chdir=/app \
    --workers 2 \
    --threads 4 \
    --timeout 120 \
    --reload
